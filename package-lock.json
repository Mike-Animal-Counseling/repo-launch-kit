{
  "name": "launch-kit-workspace-example",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "launch-kit-workspace-example",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@example/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@example/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@example/cli",
      "version": "0.1.0"
    },
    "packages/core": {
      "name": "@example/core",
      "version": "0.1.0"
    }
  }
}
